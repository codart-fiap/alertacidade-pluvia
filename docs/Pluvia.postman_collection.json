{
  "info": {
    "name": "Pluvia API",
    "description": "Colecao Postman da API do Pluvia (Global Solution 2026/2 - CitizenTech). Configure adminEmail/adminPassword localmente para autenticar como ADMIN. O token e salvo automaticamente. Configure citizenEmail/citizenPassword para testar o perfil CIDADAO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "citizenEmail",
      "value": ""
    },
    {
      "key": "citizenPassword",
      "value": ""
    },
    {
      "key": "deviceKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CIDADAO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{citizenEmail}}\",\n  \"senha\": \"{{citizenPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar cidadão",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Silva\",\n  \"email\": \"maria@exemplo.com\",\n  \"senha\": \"senha12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Áreas de risco",
      "item": [
        {
          "name": "Listar áreas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas-risco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco"
              ]
            }
          }
        },
        {
          "name": "Buscar área por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas-risco/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco",
                "1"
              ]
            }
          }
        },
        {
          "name": "Criar área (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/areas-risco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Área C - Avenida alagável (exemplo)\",\n  \"latitude\": -23.55,\n  \"longitude\": -46.63,\n  \"raioMetros\": 400,\n  \"nivelRisco\": \"MEDIO\",\n  \"ativa\": true\n}"
            }
          }
        },
        {
          "name": "Atualizar área (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/areas-risco/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Área A - atualizada\",\n  \"latitude\": -23.55,\n  \"longitude\": -46.63,\n  \"raioMetros\": 400,\n  \"nivelRisco\": \"MEDIO\",\n  \"ativa\": true\n}"
            }
          }
        },
        {
          "name": "Excluir área (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas-risco/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco",
                "3"
              ]
            },
            "description": "Use o id de uma área criada por voce e sem sensores. Areas com sensores retornam 409."
          }
        }
      ]
    },
    {
      "name": "Sensores e leituras",
      "item": [
        {
          "name": "Listar sensores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sensores"
              ]
            }
          }
        },
        {
          "name": "Leitura abaixo do limite (sem alerta)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensores/1/leituras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sensores",
                "1",
                "leituras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 120.5\n}"
            }
          }
        },
        {
          "name": "Leitura acima do limite (gera alerta ALTO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensores/1/leituras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sensores",
                "1",
                "leituras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 480\n}"
            }
          }
        },
        {
          "name": "Leitura com chave de dispositivo (como o ESP32 do Wokwi)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Key",
                "value": "{{deviceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensores/1/leituras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sensores",
                "1",
                "leituras"
              ]
            },
            "description": "Sem token: o sensor se identifica pelo cabecalho X-Device-Key (app.device-key da API).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 350\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Alertas",
      "item": [
        {
          "name": "Listar alertas recentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alertas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alertas"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Pontos seguros",
      "item": [
        {
          "name": "Listar pontos seguros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pontos-seguros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pontos-seguros"
              ]
            }
          }
        },
        {
          "name": "Criar ponto seguro (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pontos-seguros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pontos-seguros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ginásio Municipal (exemplo)\",\n  \"latitude\": -23.52,\n  \"longitude\": -46.6\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Recomendação",
      "item": [
        {
          "name": "Minha localização - dentro da Área A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recomendacao?lat=-23.5160&lng=-46.6280",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recomendacao"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-23.5160"
                },
                {
                  "key": "lng",
                  "value": "-46.6280"
                }
              ]
            }
          }
        },
        {
          "name": "Minha localização - longe das áreas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recomendacao?lat=-23.6500&lng=-46.7500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recomendacao"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-23.6500"
                },
                {
                  "key": "lng",
                  "value": "-46.7500"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Casos de erro (para o plano de testes)",
      "item": [
        {
          "name": "Sem token (esperado 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas-risco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco"
              ]
            },
            "description": "Remova o token ou use auth 'No Auth'."
          }
        },
        {
          "name": "Dados inválidos (esperado 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/areas-risco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\",\n  \"latitude\": 200,\n  \"longitude\": 0,\n  \"raioMetros\": -5,\n  \"nivelRisco\": \"MEDIO\"\n}"
            }
          }
        },
        {
          "name": "Área inexistente (esperado 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas-risco/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco",
                "9999"
              ]
            }
          }
        },
        {
          "name": "Login com senha errada (esperado 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"senha-incorreta\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Dispositivo tentando criar área (esperado 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Key",
                "value": "{{deviceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/areas-risco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco"
              ]
            },
            "description": "O perfil DISPOSITIVO so pode enviar leituras e consultar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Área C - Avenida alagável (exemplo)\",\n  \"latitude\": -23.55,\n  \"longitude\": -46.63,\n  \"raioMetros\": 400,\n  \"nivelRisco\": \"MEDIO\",\n  \"ativa\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Leitura com chave de dispositivo errada (esperado 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Key",
                "value": "chave-errada"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensores/1/leituras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sensores",
                "1",
                "leituras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 350\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Cidadão tentando criar área (esperado 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/areas-risco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "areas-risco"
              ]
            },
            "description": "Rode antes o Login CIDADAO (o token fica salvo na variavel).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Área C - Avenida alagável (exemplo)\",\n  \"latitude\": -23.55,\n  \"longitude\": -46.63,\n  \"raioMetros\": 400,\n  \"nivelRisco\": \"MEDIO\",\n  \"ativa\": true\n}"
            }
          }
        },
        {
          "name": "E-mail já cadastrado (esperado 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Outra pessoa\",\n  \"email\": \"{{citizenEmail}}\",\n  \"senha\": \"senha12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
